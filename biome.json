{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "html": { "experimentalFullSupportEnabled": true },
  "css": { "parser": { "tailwindDirectives": true } },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!.murmur",
      "!.gstack",
      "!**/.astro",
      "!**/.wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noBannedTypes": "error",
        "useLiteralKeys": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noGlobalEval": "error",
        "noSecrets": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noInferrableTypes": "off",
        "noNamespace": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noRestrictedGlobals": "error",
        "useReadonlyClassProperties": "error",
        "useConst": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noShadowRestrictedNames": "error"
      }
    }
  }
}
