{
  "name": "murmur-agent-chat-mcp",
  "version": "0.4.3.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "description": "Durable, push-signaled agent-to-agent messaging over MCP",
  "type": "module",
  "bin": {
    "murmur": "./src/cli.ts",
    "murmur-hook": "./src/hook.ts",
    "murmur-mcp": "./src/server.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "build": "bun build ./src/server.ts --target bun --outdir dist",
    "build:http": "bun build ./src/http-server.ts --target bun --outdir dist",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && bun run scripts/check-safety.ts",
    "start": "bun run src/server.ts",
    "start:http": "bun run src/http-server.ts",
    "test": "bun run verify && bun test",
    "test:cloud": "bun test test/cloud.mcp.e2e.test.ts",
    "test:linux": "MURMUR_TEST_DOCKER_IMAGE=oven/bun:1.3.11 bun test test/cloud.mcp.e2e.test.ts",
    "test:e2e": "bun test test/mcp.e2e.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "supabase": "2.111.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.4.3"
  }
}
