#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_DIR=$(dirname "$SCRIPT_DIR")

if [ -z "${MURMUR_DATABASE_URL:-}" ] && [ -z "${MURMUR_DB_PATH:-}" ] && command -v security >/dev/null 2>&1; then
  MURMUR_KEYCHAIN_URL=$(security find-generic-password \
    -a murmur \
    -s murmur-cloud-database-url \
    -w 2>/dev/null || true)
  if [ -n "$MURMUR_KEYCHAIN_URL" ]; then
    MURMUR_DATABASE_URL=$MURMUR_KEYCHAIN_URL
    export MURMUR_DATABASE_URL
  fi
  unset MURMUR_KEYCHAIN_URL
fi

if [ -z "${MURMUR_DB_PATH:-}" ] && [ -z "${MURMUR_DATABASE_URL:-}" ]; then
  MURMUR_DB_PATH="$PROJECT_DIR/.murmur/messages.db"
  export MURMUR_DB_PATH
fi

if [ -z "${MURMUR_DATABASE_CA_PATH:-}" ] && [ -n "${MURMUR_DATABASE_URL:-}" ]; then
  DEFAULT_CA_PATH="${HOME:-}/Downloads/prod-ca-2021.crt"
  if [ -n "${HOME:-}" ] && [ -f "$DEFAULT_CA_PATH" ]; then
    MURMUR_DATABASE_CA_PATH="$DEFAULT_CA_PATH"
    export MURMUR_DATABASE_CA_PATH
  fi
  unset DEFAULT_CA_PATH
fi

resolve_bun() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi
  if [ -n "${BUN_INSTALL:-}" ] && [ -x "$BUN_INSTALL/bin/bun" ]; then
    printf '%s\n' "$BUN_INSTALL/bin/bun"
    return 0
  fi
  if [ -n "${HOME:-}" ] && [ -x "$HOME/.bun/bin/bun" ]; then
    printf '%s\n' "$HOME/.bun/bin/bun"
    return 0
  fi
  if [ -x /opt/homebrew/bin/bun ]; then
    printf '%s\n' /opt/homebrew/bin/bun
    return 0
  fi
  if [ -x /usr/local/bin/bun ]; then
    printf '%s\n' /usr/local/bin/bun
    return 0
  fi
  return 1
}

BUN_BIN=$(resolve_bun || true)

if [ -z "$BUN_BIN" ]; then
  echo "Murmur requires Bun 1.3.14 or newer. Install it from https://bun.sh" >&2
  exit 1
fi

cd "$PROJECT_DIR"
exec "$BUN_BIN" run "$PROJECT_DIR/src/server.ts"
