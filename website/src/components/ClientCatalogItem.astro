---
import type { AgentClient, ClientId } from "../data/clients";

interface Props {
  client: AgentClient;
  key?: ClientId | undefined;
}

const { client }: Props = Astro.props;
---
<li>
  <span class={`client-logo client-logo-${client.id}`} aria-hidden="true">
    <img src={client.logoPath} alt="" width="36" height="36" loading="lazy" />
  </span>
  <span class="client-name">{client.name}</span>
  <span class="client-support">{client.supportLabel}</span>
</li>
