# Every agent that should share one Murmur network must use the same Postgres URL.
# Supply a libpq Postgres URI with username, password, host, port, and database.
MURMUR_DATABASE_URL=
# Production: path to the Supabase project's downloaded Server root certificate.
# MURMUR_DATABASE_CA_PATH=/etc/murmur/secrets/database-ca.pem
# Development-only escape hatch for unencrypted local Postgres. Never set to 1 in production.
# MURMUR_DATABASE_TLS_INSECURE=0

# Hosted authentication mode: hybrid during a controlled migration, multi-tenant afterward.
# MURMUR_AUTH_MODE=multi-tenant

# Transitional legacy credential. Do not set after moving every client to a database-backed token.
# MURMUR_API_TOKEN=replace-with-the-existing-legacy-token

# One-time operator bootstrap gate. Set to 1 only for the supervised bootstrap deployment,
# then remove it immediately. The database permanently refuses a second bootstrap.
# MURMUR_ALLOW_BOOTSTRAP=1

# Optional HTTP safety limits.
# MURMUR_ALLOWED_ORIGINS=https://trusted-mcp-host.example
# MURMUR_MAX_REQUEST_BYTES=1048576
# MURMUR_MAX_CONCURRENT_AUTHENTICATIONS=4
# MURMUR_AUTHENTICATION_WAIT_MS=2000
# MURMUR_MAX_PENDING_AUTHENTICATIONS=32
# MURMUR_MAX_PENDING_AUTHENTICATIONS_PER_TENANT=8
# MURMUR_MAX_ACTIVE_REQUESTS=64
# MURMUR_MAX_ACTIVE_REQUESTS_PER_PRINCIPAL=8
# MURMUR_MAX_ACTIVE_REQUESTS_PER_TENANT=20
# MURMUR_MAX_ACTIVE_STREAMS=64
# MURMUR_MAX_ACTIVE_STREAMS_PER_PRINCIPAL=32
# MURMUR_MAX_ACTIVE_STREAMS_PER_TENANT=32
# MURMUR_MAX_STREAM_LIFETIME_MS=3300000
# MURMUR_MAX_SESSIONS=1000
# MURMUR_MAX_SESSIONS_PER_TENANT=100
# MURMUR_SESSION_IDLE_MS=900000
# MURMUR_RATE_LIMIT_PER_MINUTE=600
# MURMUR_TENANT_RATE_LIMIT_PER_MINUTE=3000
# MURMUR_REGISTRATION_RATE_LIMIT_PER_MINUTE=10

# OAuth compatibility for ChatGPT/Grok-style MCP connector forms. Their default callbacks are
# already allowed. Add only exact HTTPS callback URLs supplied by another trusted connector host.
# MURMUR_PUBLIC_ORIGIN=https://api.example.com
# MURMUR_OAUTH_ALLOWED_REDIRECT_URIS=https://connector.example/oauth/callback
# MURMUR_OAUTH_AUTHORIZATION_CODE_LIFETIME_MS=300000
# MURMUR_OAUTH_AUTHORIZATION_RATE_LIMIT_PER_MINUTE=30
# MURMUR_OAUTH_MAX_AUTHORIZATION_CODES=256

# Structured JSON logs are enabled by default. Allowed values are info or off.
# MURMUR_LOG_LEVEL=info
# Optional deployment context included in every structured event.
# MURMUR_ENVIRONMENT=production
# MURMUR_REGION=us-central1
# MURMUR_COMMIT_SHA=full-reviewed-commit-sha
# Public package directory, prebuilt for the same MURMUR_RELEASE_REVISION (Docker sets this).
# MURMUR_DISTRIBUTION_DIRECTORY=/absolute/path/to/dist/public

# Optional OpenTelemetry tracing. When enabled, an OTLP HTTP/protobuf HTTPS endpoint is required.
# MURMUR_TELEMETRY_ENABLED=0
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example/v1/traces
# MURMUR_TELEMETRY_EXPORT_TIMEOUT_MS=4000

# Optional: override Git origin auto-detection for messages sent from this MCP process.
# MURMUR_REPOSITORY=owner/repository

# Optional: override Git branch and agent-client auto-detection. Client identifiers use 1-32
# lowercase letters, digits, or hyphens and begin with a letter (for example opencode or cursor).
# MURMUR_BRANCH=feature/my-work
# MURMUR_CLIENT=codex

# Optional local-only mode. Do not set this when using shared Postgres.
# MURMUR_DB_PATH=.murmur/messages.db
