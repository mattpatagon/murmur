# Every agent that should share one Murmur network must use the same Postgres URL.
MURMUR_DATABASE_URL=postgresql://user:password@host:5432/postgres

# Required only when running the remote HTTP server.
# MURMUR_API_TOKEN=replace-with-a-long-random-token

# Optional: override Git origin auto-detection for messages sent from this MCP process.
# MURMUR_REPOSITORY=owner/repository

# Optional: override Git branch and agent-client auto-detection.
# MURMUR_BRANCH=feature/my-work
# MURMUR_CLIENT=codex

# Optional: enable full server-certificate verification with a local CA file.
# MURMUR_DATABASE_CA_PATH=/path/to/server-root-certificate.crt

# Optional local-only mode. Do not set this when using shared Postgres.
# MURMUR_DB_PATH=.murmur/messages.db
